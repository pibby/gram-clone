# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/gram

# Password for /admin (you're the only user)
ADMIN_PASSWORD=change-me

# Random string, at least 32 characters, used to sign the admin session cookie.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Where processed images are stored (must be persistent disk in production)
UPLOAD_DIR=./uploads

# Optional profile overrides (defaults live in lib/site.ts)
# SITE_NAME=Katie Harron
# SITE_BIO=Default bio, used until you save one in /admin → Profile
# SITE_AVATAR=/avatar-96.webp
# SITE_AVATAR_2X=/avatar-192.webp

# Optional: use system ffmpeg/ffprobe instead of the bundled binaries
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
